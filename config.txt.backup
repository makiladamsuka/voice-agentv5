# --- Hardware Interfaces ---
dtparam=i2c_arm=on
dtparam=spi=on
dtparam=i2c_vc=on

# Enables the second SPI bus (SPI1) for pins D21, D20, D19
dtoverlay=spi1-3cs
dtparam=audio=on

# --- Hardware Detection ---
camera_auto_detect=1
display_auto_detect=0
auto_initramfs=1

# --- Video Driver Settings ---

# Full-sensor camera needs more CMA for 3280x2464 raw buffers
# (vc4-kms-v3d stays off — custom 1024x600 HDMI timings need that)
dtoverlay=cma,cma-256
# MUST stay commented out for your 1024x600 timings to work
#dtoverlay=vc4-kms-v3d
max_framebuffers=2
disable_fw_kms_setup=1

# Run in 64-bit mode
arm_64bit=1
disable_overscan=1
arm_boost=1

[all]
# --- 10.1 Inch Display Settings (1024x600) ---
max_usb_current=1
hdmi_force_hotplug=1
config_hdmi_boost=7
hdmi_group=2
hdmi_mode=87
hdmi_drive=2
display_rotate=0
hdmi_timings=1024 1 50 18 50 600 1 15 3 15 0 0 0 60 0 40000000 3

# --- ACTIVE OVERCLOCK (2.1 GHz) ---
over_voltage=6
arm_freq=2100
gpu_freq=750

# Force Camera Module V2
#dtoverlay=imx219

# 3rd party Camera rev 1.3 (OV5647)
#dtoverlay=ov5647
consoleblank=0
