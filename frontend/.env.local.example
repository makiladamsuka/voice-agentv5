# Copy to frontend/.env.local (or let scripts/run-frontend-dev.sh seed from repo .env)

# Pi kiosk: backend plays TTS on speakers — keep browser audio muted
NEXT_PUBLIC_LOCAL_SPEAKER=true

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=campus-greeting-agent
KIOSK_API_URL=http://127.0.0.1:8080
